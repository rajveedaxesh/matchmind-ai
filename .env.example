# Copy to .env (project root or backend/). Every value is optional; defaults shown.

# SQLite file location (created and seeded automatically). Default: backend/data/matchmind.db.
# Relative paths resolve from the directory you start uvicorn in, so prefer an absolute path if you set it.
# MATCHMIND_DB_PATH=/absolute/path/to/matchmind.db

# Semantic text encoder: "lsa" (local, no downloads - default) or "sentence-transformers" (optional extra;
# silently falls back to lsa if the package/model is unavailable)
MATCHMIND_EMBEDDING_BACKEND=lsa
MATCHMIND_ST_MODEL=all-MiniLM-L6-v2

# Comma-separated browser origins allowed to call the API (Vite dev server by default)
MATCHMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed the fictional jobs/candidates when the database is empty
MATCHMIND_SEED_ON_STARTUP=true

# Where the built React app lives (served by FastAPI when present)
# MATCHMIND_FRONTEND_DIST=/absolute/path/to/frontend/dist
